<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Local development entitlements: virtualization only, no App Sandbox.
	     Sandbox requires a provisioning profile; omitting it lets a local ad-hoc /
	     Apple Development build run directly on this machine. The shipped build uses
	     Kapsule.entitlements (sandbox enabled) with a provisioning profile.
	     See docs/BUILD_AND_DISTRIBUTION.md. -->
	<key>com.apple.security.virtualization</key>
	<true/>
</dict>
</plist>
